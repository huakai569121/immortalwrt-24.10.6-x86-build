# ImmortalWrt v24.10.6 / x86_64 (i3-6100T 物理机 + PVE 虚拟机)
# 这是 .config 种子文件，最终由 make defconfig 补全依赖。
# 修改后请同步修改 README.md 中的参数说明。

# ---------- Target ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"

# ---------- Image / partition ----------
# 同时开启 squashfs 与 ext4，一次编译产出 BIOS/EFI 共 4 份 combined 镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_CONSOLE=y
CONFIG_QCOW2_IMAGES=y
# CONFIG_ISO_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# boot 分区 64 MiB；rootfs 分区 6144 MiB
# squashfs 固件本体约占 300~600 MiB，剩余为 overlay 可写空间，净可用 > 5 GiB
# 实际值由 workflow 输入 rootfs_partsize_mib 覆盖
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=6144
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0

# ---------- Base LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- dnsmasq 冲突处理 ----------
# dnsmasq / dnsmasq-dhcpv6 / dnsmasq-full 三者均 PROVIDES:=dnsmasq，互斥
# OpenClash 依赖 dnsmasq-full，必须显式禁用另外两个
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ---------- 指定内置插件 ----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y
# Turbo ACC 本次不内置：此行会由 diy-part2.sh 在 turboacc_mode=none 时删除
CONFIG_PACKAGE_luci-app-turboacc=y

# ---------- 关键依赖显式兜底 ----------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_smartmontools=y
